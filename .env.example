# ---------------------------------------------------------------------------
# Polymarket BTC Up/Down 5m dataset collector - example configuration
# Copy to .env and adjust. No API secrets are required: all endpoints are public.
# ---------------------------------------------------------------------------

# --- Core ---
SNAPSHOT_INTERVAL_MS=250
DATA_DIR=./data
LOG_LEVEL=info

# --- Feeds ---
POLYMARKET_ENABLED=true
BINANCE_ENABLED=true
# Optional secondary BTC reference feed (Chainlink BTC/USD via Polymarket RTDS).
# This is the resolution-relevant reference price for the 5m Up/Down markets.
CHAINLINK_ENABLED=true

# --- Reconnection ---
RECONNECT_INITIAL_DELAY_MS=1000
RECONNECT_MAX_DELAY_MS=30000

# --- Connection health ---
# Reconnect a feed if no message (incl. heartbeat) arrives for this long.
STALE_TIMEOUT_MS=60000
HEALTH_CHECK_INTERVAL_MS=5000

# --- Polymarket market discovery ---
# Window length of the recurring market series (seconds). Do not change unless
# Polymarket changes the series.
MARKET_WINDOW_SEC=300
# How often to re-check which market window is active.
DISCOVERY_POLL_MS=5000
# Subscribe to the next market this many ms before its window starts.
PRESUBSCRIBE_AHEAD_MS=30000
# Keep collecting the expired market for this long after rollover (captures
# late prints), then unsubscribe.
MARKET_UNSUB_GRACE_MS=15000

# Optional explicit overrides (normally leave empty for auto-discovery):
# POLYMARKET_MARKET_SLUG=btc-updown-5m-1789052400
# POLYMARKET_UP_TOKEN_ID=
# POLYMARKET_DOWN_TOKEN_ID=
# POLYMARKET_CONDITION_ID=

# --- Endpoints (defaults are the official public endpoints) ---
GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_RTDS_URL=wss://ws-live-data.polymarket.com
BINANCE_WS_URL=wss://stream.binance.com:9443/stream?streams=btcusdt@trade/btcusdt@bookTicker
BINANCE_SYMBOL=BTCUSDT

# --- Storage ---
# Flush buffered JSONL to disk at least this often.
FLUSH_INTERVAL_MS=1000

# --- Stats ---
STATS_INTERVAL_MS=30000
